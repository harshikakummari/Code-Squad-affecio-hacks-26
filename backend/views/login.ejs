
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | Beyond the Swipe</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .auth-container {
      max-width: 420px;
      margin: 70px auto;
      padding: 30px;
      border-radius: 18px;
      background: white;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    .auth-container h1,
    .auth-container p {
      text-align: center;
    }

    .auth-container p {
      color: #666;
    }

    .auth-container label {
      display: block;
      margin-top: 18px;
      margin-bottom: 6px;
    }

    .auth-container input {
      box-sizing: border-box;
      width: 100%;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 8px;
    }

    .auth-container button {
      width: 100%;
      margin-top: 22px;
      padding: 12px;
      border: none;
      border-radius: 8px;
      background: #d9468d;
      color: white;
      cursor: pointer;
    }

    .auth-link {
      margin-top: 18px;
      text-align: center;
    }
  </style>
</head>
<body>
  <main class="auth-container">
    <h1>💕 Welcome Back!</h1>
    <p>Log in to Beyond the Swipe.</p>

    <form action="/login" method="POST">
      <label for="email">Email address</label>
      <input
        type="email"
        id="email"
        name="email"
        autocomplete="email"
        required
      >

      <label for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        autocomplete="current-password"
        required
      >

      <button type="submit">Log In</button>
    </form>

    <p class="auth-link">
      Don't have an account? <a href="/signup">Sign up</a>
    </p>
  </main>
</body>
</html>
